# Copiá este archivo a .env y completá con los datos de tu proyecto de Supabase
# (Project Settings → API). La anon/publishable key es pública por diseño: está bien que vaya al navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Opcional: servidores STUN/TURN en JSON (si algún amigo no puede conectar por NAT estricto).
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:TU-TURN:3478","username":"u","credential":"p"}]
