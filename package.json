{
  "name": "project-rubble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arena brawler isométrico en el navegador: knockback físico, mapa destructible, multijugador P2P (WebRTC) con signaling en Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "showcase": "node tests/e2e/showcase.mjs",
    "assets:doc": "UPDATE_ASSET_DOC=1 vitest run tests/assets.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
